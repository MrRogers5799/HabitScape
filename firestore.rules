rules_version = '2';

// HabitScape Firestore security rules.
// Source of truth for production. Deploy with:
//   npx firebase-tools@15.34.0 deploy --only firestore:rules --project <project-id>
// The local test environment (test-env/) runs these same rules in the emulator.
//
// Model: every user's data lives under users/{uid} and only that user can touch it.
// The one shared collection is sharedTemplates/{code} (workout share codes).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── User profile ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      // The profile's uid field must match the document and can never change.
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      // get() keeps older profiles without a uid field editable.
      allow update: if isOwner(uid)
        && request.resource.data.get('uid', null) == resource.data.get('uid', null);

      // Skills, tracked activities, completions, workouts and everything else
      // under the user: owner only. The {sub} segment matters: in rules v2 a bare
      // {document=**} also matches users/{uid} itself and would bypass the checks above.
      // The game layer's collections have their own, stricter rules below.
      match /{sub}/{document=**} {
        allow read, write: if isOwner(uid) && !(sub in ['game', 'trips']);
      }

      // ── Adventure (beta) game layer (PROD-018) ─────────────────────────
      // game/adventurer holds levels, bank, adventure time and progress. Every save
      // must raise `rev` by exactly one, so a stale device can't overwrite newer progress.
      function validAdventurer() {
        let d = request.resource.data;
        return d.keys().hasOnly(['schemaVersion', 'rev', 'xp', 'bank', 'time', 'quests', 'kills',
                                 'dryKills', 'lamps', 'ordersFilled', 'collection', 'journey', 'activeTripId', 'updatedAt'])
          && d.schemaVersion is int && d.rev is int
          && d.xp is map && d.bank is map && d.time is map && d.quests is map
          && d.kills is map && d.dryKills is map && d.lamps is list
          && (!('ordersFilled' in d) || d.ordersFilled is map)
          && (!('collection' in d) || d.collection is map)
          && (!('journey' in d) || d.journey is map)
          && (d.activeTripId == null || d.activeTripId is string);
      }
      match /game/{docId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && docId == 'adventurer' && validAdventurer()
          && request.resource.data.rev == 0;
        allow update: if isOwner(uid) && validAdventurer()
          && request.resource.data.rev == resource.data.rev + 1;
      }

      // trips/{tripId}: the adventurer's queue, its blocks, progress and running log (1 to 40 blocks, PROG-045).
      function validTrip() {
        let d = request.resource.data;
        return d.keys().hasOnly(['schemaVersion', 'startMs', 'legs', 'nextChunk', 'done',
                                 'finishedMs', 'report', 'seenMs', 'updatedAt'])
          && d.schemaVersion is int && d.startMs is number
          && d.legs is list && d.legs.size() >= 1 && d.legs.size() <= 40
          && d.nextChunk is int && d.done is bool && d.report is map;
      }
      match /trips/{tripId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTrip();
      }
    }

    // ── Workout share codes ──────────────────────────────────────────────
    match /sharedTemplates/{code} {
      // Fetch by exact code only; nobody can list or browse codes.
      allow get: if signedIn();
      allow list: if false;
      // Create-only, stamped with the creator, bounded in size. A code that
      // already exists can't be overwritten (that would be an update).
      allow create: if signedIn()
        && code.size() == 6
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.templates is list
        && request.resource.data.templates.size() > 0
        && request.resource.data.templates.size() <= 20;
      allow update: if false;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
