rules_version = '2';
// LOCAL EMULATOR ONLY. Not the production rules (those live in the Firebase
// console; see vault open question OQ-04). Signed-in users may read and write
// their own subtree; share codes are readable by any signed-in user.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /sharedTemplates/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
