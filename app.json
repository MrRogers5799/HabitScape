{
  "expo": {
    "name": "HabitScape",
    "slug": "HabitScape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/icon.png",
    "scheme": "habitscape",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.buckorogers.habitscape",
      "versionCode": 16,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0d1117",
        "foregroundImage": "./assets/logo/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/logo/adaptive-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-logo.png",
          "imageWidth": 200,
          "backgroundColor": "#080c18"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "habitscape",
          "project": "habitscape"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/HabitScape"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb7869be-2040-4f5a-b9c2-5c3077eb55f5"
      }
    },
    "owner": "mrrogers"
  }
}
